<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - testman</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Testman.Web.styles.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
    <header>
        <nav class="navbar navbar-dark testman-navbar border-bottom">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand fw-semibold" asp-page="/Index">testman</a>
                <span class="navbar-text text-white-50 small">Local test execution</span>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-3 px-lg-4">
        <main role="main" class="py-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
