@page
@model IndexModel
@{
    ViewData["Title"] = "Specifications";
}

<header class="d-flex justify-content-end mb-4">
    <div class="btn-group" role="group" aria-label="Specification view mode">
        <a class="btn @(Model.IsVerificationMode ? "btn-outline-primary" : "btn-primary")" href="/" aria-pressed="@(Model.IsVerificationMode ? "false" : "true")">Test patterns</a>
        <a class="btn @(Model.IsVerificationMode ? "btn-primary" : "btn-outline-primary")" href="/?mode=verification" aria-pressed="@(Model.IsVerificationMode ? "true" : "false")">Verification</a>
    </div>
</header>

<section class="alert @(Model.PageContent.Diagnostics.Count > 0 ? "alert-warning" : "alert-light") border shadow-sm" aria-labelledby="diagnostics-heading">
    <div class="d-flex align-items-center justify-content-between gap-3">
        <div>
            <h2 class="h6 mb-1" id="diagnostics-heading">Specification diagnostics</h2>
            @if (Model.PageContent.Diagnostics.Count == 0)
            {
                <p class="text-body-secondary small mb-0">No parsing diagnostics.</p>
            }
            else
            {
                <ul class="mb-0 mt-2">
                    @foreach (var diagnostic in Model.PageContent.Diagnostics)
                    {
                        <li>
                            <strong>@diagnostic.SourcePath@if (diagnostic.LineNumber is int lineNumber){<text>:@lineNumber</text>}</strong>
                            <span> — @diagnostic.Reason</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</section>

@if (Model.IsVerificationMode)
{
<details data-disclosure-key="test-list" class="card border-0 shadow-sm mt-4 specification-card test-list-card" open>
    <summary class="card-header bg-body-tertiary d-flex justify-content-between gap-2">
        <h2 class="h4 mb-0" id="test-list-heading">Test list</h2>
        <span class="specification-toggle" aria-hidden="true"></span>
    </summary>
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Specification file</th>
                        <th scope="col">Pass</th>
                        <th scope="col">Fail</th>
                        <th scope="col">Blocked</th>
                        <th scope="col">N/A</th>
                        <th scope="col">Not Tested</th>
                        <th scope="col">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PageContent.TestList)
                    {
                        <tr>
                            <th scope="row">
                                @item.SourcePath
                                @if (item.SpecificationRevision is not null)
                                {
                                    <text> (@item.SpecificationRevision)</text>
                                }
                                else
                                {
                                    <text> (Git revision unavailable)</text>
                                }
                            </th>
                            <td>@item.Pass</td>
                            <td>@item.Fail</td>
                            <td>@item.Blocked</td>
                            <td>@item.NotApplicable</td>
                            <td>@item.NotTested</td>
                            <td>@item.Total</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</details>
}

@{ var resultIndex = 0; }
<form method="post" asp-route-mode="verification" asp-fragment="result-submission">
<input asp-for="ConfirmPartial" type="hidden" />
@foreach (var file in Model.PageContent.Files)
{
    <details class="card border-0 shadow-sm mt-4 specification-card"
             data-disclosure-key="specification:@file.SourcePath"
             open>
        <summary class="card-header bg-body-tertiary d-flex flex-wrap justify-content-between gap-2">
            <span>
                @file.SourcePath
                @if (file.SpecificationRevision is not null)
                {
                    <text> (@file.SpecificationRevision)</text>
                }
                else
                {
                    <text> (Git revision unavailable)</text>
                }
            </span>
            <span class="d-flex align-items-center gap-2">
                <span class="badge text-bg-secondary">Format version @file.FormatVersion</span>
                <span class="specification-toggle" aria-hidden="true"></span>
            </span>
        </summary>
        @if (file.Summary is not null)
        {
            <div class="card-body border-bottom py-3">
                <div class="d-flex flex-wrap gap-2" aria-label="Current test status">
                    <span class="badge text-bg-dark">Total @file.Summary.Total</span>
                    <span class="badge text-bg-success">Pass @file.Summary.Pass</span>
                    <span class="badge text-bg-danger">Fail @file.Summary.Fail</span>
                    <span class="badge text-bg-warning">Blocked @file.Summary.Blocked</span>
                    <span class="badge text-bg-info">N/A @file.Summary.NotApplicable</span>
                    <span class="badge text-bg-secondary">Not Tested @file.Summary.NotTested</span>
                </div>
            </div>
        }
        <div class="card-body p-4">
            @foreach (var title in file.Titles)
            {
                <article class="mb-5">
                    <h2 class="h4">@title.Name</h2>
                    @if (Model.IsVerificationMode)
                    {
                        <section class="mb-3">
                            <h3 class="h6">Preconditions</h3>
                            <div>@Html.Raw(title.PreconditionsHtml)</div>
                        </section>
                        <section class="mb-3">
                            <h3 class="h6">Common steps</h3>
                            <div>@Html.Raw(title.CommonStepsHtml)</div>
                        </section>
                        <div class="table-responsive">
                            <table class="table table-striped align-middle verification-table">
                                <colgroup>
                                    <col class="verification-col-id" />
                                    <col class="verification-col-steps" />
                                    <col class="verification-col-expected" />
                                    <col class="verification-col-previous" />
                                    <col class="verification-col-result" />
                                    <col class="verification-col-comment" />
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th scope="col">Test ID</th>
                                        <th scope="col">Steps</th>
                                        <th scope="col">Expected result</th>
                                        <th scope="col">Previous result</th>
                                        <th scope="col">Result input</th>
                                        <th scope="col">Optional comment</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var testCase in title.VerificationCases)
                                    {
                                        <tr>
                                            <th scope="row">@testCase.Id</th>
                                            <td class="markdown-content test-steps">@Html.Raw(testCase.StepsHtml)</td>
                                            <td>@Html.Raw(testCase.ExpectedResultHtml)</td>
                                            <td>
                                                @if (testCase.PreviousResult is null)
                                                {
                                                    <span class="badge text-bg-secondary">Not Tested</span>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-primary">@testCase.PreviousResult.OutcomeLabel</span>
                                                }
                                                @if (testCase.History.Count > 0)
                                                {
                                                    <details class="mt-2">
                                                        <summary>History (@testCase.History.Count)</summary>
                                                        <ol class="small ps-3 mt-2 mb-0">
                                                            @foreach (var result in testCase.History)
                                                            {
                                                                <li class="mb-2">
                                                                    <strong>@result.OutcomeLabel</strong>
                                                                    <span> — @result.ExecutedAtLocal.ToString("g") — @result.ExecutedBy</span>
                                                                    <div>@result.TestTargetName</div>
                                                                    @if (!string.IsNullOrEmpty(result.Comment))
                                                                    {
                                                                        <div>@result.Comment</div>
                                                                    }
                                                                </li>
                                                            }
                                                        </ol>
                                                    </details>
                                                }
                                            </td>
                                            <td>
                                                @if (testCase.CanRegisterResult)
                                                {
                                                    <input asp-for="ResultCases[resultIndex].SourcePath" type="hidden" />
                                                    <input asp-for="ResultCases[resultIndex].TestCaseId" type="hidden" />
                                                    <label class="visually-hidden" for="ResultCases_@(resultIndex)__Outcome">Result for @testCase.Id</label>
                                                    <select asp-for="ResultCases[resultIndex].Outcome" class="form-select">
                                                        <option value="">Select result</option>
                                                        <option value="pass">Pass</option>
                                                        <option value="fail">Fail</option>
                                                        <option value="blocked">Blocked</option>
                                                        <option value="not_applicable">N/A</option>
                                                    </select>
                                                }
                                                else
                                                {
                                                    <span class="text-body-secondary">Registration unavailable</span>
                                                }
                                            </td>
                                            <td>
                                                @if (testCase.CanRegisterResult)
                                                {
                                                    <label class="visually-hidden" for="ResultCases_@(resultIndex)__Comment">Comment for @testCase.Id</label>
                                                    <textarea asp-for="ResultCases[resultIndex].Comment" class="form-control" rows="2" placeholder="Optional comment"></textarea>
                                                    resultIndex++;
                                                }
                                                else
                                                {
                                                    <span class="text-body-secondary">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">@Html.Raw(title.OverviewHtml)</div>
                        <div class="table-responsive">
                            <table class="table table-striped align-middle">
                                <thead>
                                    <tr>
                                        <th scope="col">Major item</th>
                                        <th scope="col">Middle item</th>
                                        <th scope="col">Minor item</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pattern in title.Patterns)
                                    {
                                        <tr>
                                            @if (pattern.MajorItemRowSpan > 0)
                                            {
                                                <td rowspan="@pattern.MajorItemRowSpan">@pattern.MajorItem</td>
                                            }
                                            @if (pattern.MiddleItemRowSpan > 0)
                                            {
                                                <td rowspan="@pattern.MiddleItemRowSpan">@pattern.MiddleItem</td>
                                            }
                                            @if (pattern.MinorItemRowSpan > 0)
                                            {
                                                <td rowspan="@pattern.MinorItemRowSpan">@pattern.MinorItem</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </article>
            }
        </div>
    </details>
}
@if (Model.IsVerificationMode)
{
    <section class="card border-0 shadow-sm mt-4" id="result-submission">
        <div class="card-body p-4">
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
            }
            @if (!string.IsNullOrEmpty(Model.SystemErrorMessage))
            {
                <div class="alert alert-danger" role="alert">@Model.SystemErrorMessage</div>
            }
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>
            }
            @if (!string.IsNullOrEmpty(Model.ConfirmationMessage))
            {
                <div class="alert alert-warning" role="alert">@Model.ConfirmationMessage</div>
            }
            <div class="d-flex flex-column flex-md-row gap-3 align-items-md-end">
                <div class="flex-grow-1">
                    <label asp-for="TestTargetName" class="form-label">Test target name</label>
                    <input asp-for="TestTargetName" class="form-control" required />
                </div>
                <div class="flex-grow-1">
                    <label asp-for="ExecutedBy" class="form-label">Executed by</label>
                    <input asp-for="ExecutedBy" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary">
                    @(Model.ConfirmPartial ? "Confirm selected results" : "Save results")
                </button>
            </div>
        </div>
    </section>
}
</form>
