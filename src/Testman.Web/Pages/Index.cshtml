@page
@model IndexModel
@{
    ViewData["Title"] = "Specifications";
}

<header class="d-flex flex-column flex-lg-row gap-3 align-items-lg-center justify-content-between mb-4">
    <div>
        <p class="text-uppercase text-primary fw-semibold small mb-1">Test specifications</p>
        <h1 class="h2 mb-1">Specification workspace</h1>
        <p class="text-body-secondary mb-0">Review test coverage, then switch to verification when you are ready to execute.</p>
    </div>
    <div class="btn-group" role="group" aria-label="Specification view mode">
        <a class="btn @(Model.IsVerificationMode ? "btn-outline-primary" : "btn-primary")" href="/" aria-pressed="@(!Model.IsVerificationMode)">Test patterns</a>
        <a class="btn @(Model.IsVerificationMode ? "btn-primary" : "btn-outline-primary")" href="/?mode=verification" aria-pressed="@Model.IsVerificationMode">Verification</a>
    </div>
</header>

<section class="alert @(Model.PageContent.Diagnostics.Count > 0 ? "alert-warning" : "alert-light") border shadow-sm" aria-labelledby="diagnostics-heading">
    <div class="d-flex align-items-center justify-content-between gap-3">
        <div>
            <h2 class="h6 mb-1" id="diagnostics-heading">Specification diagnostics</h2>
            @if (Model.PageContent.Diagnostics.Count == 0)
            {
                <p class="text-body-secondary small mb-0">No parsing diagnostics.</p>
            }
            else
            {
                <ul class="mb-0 mt-2">
                    @foreach (var diagnostic in Model.PageContent.Diagnostics)
                    {
                        <li>
                            <strong>@diagnostic.SourcePath@if (diagnostic.LineNumber is int lineNumber){<text>:@lineNumber</text>}</strong>
                            <span> — @diagnostic.Reason</span>
                        </li>
                    }
                </ul>
            }
        </div>
        <span class="badge @(Model.PageContent.Diagnostics.Count > 0 ? "text-bg-warning" : "text-bg-success")">
            @(Model.PageContent.Diagnostics.Count > 0 ? "Needs attention" : "Ready")
        </span>
    </div>
</section>

@foreach (var file in Model.PageContent.Files)
{
    <section class="card border-0 shadow-sm mt-4">
        <div class="card-header bg-body-tertiary d-flex flex-wrap justify-content-between gap-2">
            <span>@file.SourcePath</span>
            <span class="badge text-bg-secondary">Format version @file.FormatVersion</span>
        </div>
        <div class="card-body p-4">
            @foreach (var title in file.Titles)
            {
                <article class="mb-5">
                    <h2 class="h4">@title.Name</h2>
                    @if (Model.IsVerificationMode)
                    {
                        <section class="mb-3">
                            <h3 class="h6">Preconditions</h3>
                            <div>@Html.Raw(title.PreconditionsHtml)</div>
                        </section>
                        <section class="mb-3">
                            <h3 class="h6">Common steps</h3>
                            <div>@Html.Raw(title.CommonStepsHtml)</div>
                        </section>
                        <div class="table-responsive">
                            <table class="table table-striped align-middle">
                                <thead>
                                    <tr>
                                        <th scope="col">Test ID</th>
                                        <th scope="col">Steps</th>
                                        <th scope="col">Expected result</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var testCase in title.VerificationCases)
                                    {
                                        <tr>
                                            <th scope="row">@testCase.Id</th>
                                            <td>@Html.Raw(testCase.StepsHtml)</td>
                                            <td>@Html.Raw(testCase.ExpectedResultHtml)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">@Html.Raw(title.OverviewHtml)</div>
                        <div class="table-responsive">
                            <table class="table table-striped align-middle">
                                <thead>
                                    <tr>
                                        <th scope="col">Major item</th>
                                        <th scope="col">Middle item</th>
                                        <th scope="col">Minor item</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pattern in title.Patterns)
                                    {
                                        <tr>
                                            <td>@pattern.MajorItem</td>
                                            <td>@pattern.MiddleItem</td>
                                            <td>@pattern.MinorItem</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </article>
            }
        </div>
    </section>
}
